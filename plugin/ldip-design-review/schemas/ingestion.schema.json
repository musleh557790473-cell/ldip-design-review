{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://aicc.local/ldip/ingestion.schema.json",
 "title": "LDIP common ingestion file (*.dwg.json, *.pdf.json) \u2014 SPC-0006 Rev B \u00a72.4, \u00a74.1.4",
 "description": "template_version 1.0. DWG content per \u00a74.1.4 (skill 1); PDF content per \u00a74.2.4 (skill 2 extracting-pdf-drawings 0.1.0); PDF title block per K5-1 (11 Oct 2026, optional fields added).",
 "type": "object",
 "required": [
  "template_version",
  "source",
  "extractor",
  "crs",
  "title_block",
  "content",
  "warnings",
  "meta"
 ],
 "additionalProperties": false,
 "properties": {
  "template_version": {
   "const": "1.0"
  },
  "source": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "minLength": 1,
     "maxLength": 250
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
     "type": "integer",
     "minimum": 0
    },
    "document_no": {
     "type": [
      "string",
      "null"
     ]
    },
    "revision": {
     "type": [
      "string",
      "null"
     ]
    },
    "file_type": {
     "enum": [
      "dwg",
      "pdf"
     ]
    }
   },
   "required": [
    "path",
    "sha256",
    "bytes",
    "document_no",
    "revision",
    "file_type"
   ],
   "additionalProperties": false
  },
  "extractor": {
   "type": "object",
   "properties": {
    "skill": {
     "enum": [
      "extracting-dwg-data",
      "extracting-pdf-drawings"
     ]
    },
    "script": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "converter": {
     "type": "object",
     "properties": {
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "version": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "version"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "skill",
    "script",
    "version",
    "converter"
   ],
   "additionalProperties": false
  },
  "crs": {
   "type": "object",
   "properties": {
    "declared": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^EPSG:[0-9]{4,5}$"
    },
    "units": {
     "enum": [
      "m",
      "mm",
      "unknown"
     ]
    },
    "insunits": {
     "type": [
      "integer",
      "null"
     ]
    }
   },
   "required": [
    "declared",
    "units",
    "insunits"
   ],
   "additionalProperties": false
  },
  "title_block": {
