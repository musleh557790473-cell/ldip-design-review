      "version"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "skill",
    "script",
    "version",
    "converter"
   ],
   "additionalProperties": false
  },
  "crs": {
   "type": "object",
   "properties": {
    "declared": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^EPSG:[0-9]{4,5}$"
    },
    "units": {
     "type": "string",
     "minLength": 1,
     "description": "dwg / pdf: m | mm | unknown (enforced below); landxml: m, mm, or the LandXML linearUnit as read (Rev C I4)"
    },
    "insunits": {
     "type": [
      "integer",
      "null"
     ]
    }
   },
   "required": [
    "declared",
    "units",
    "insunits"
   ],
   "additionalProperties": false
  },
