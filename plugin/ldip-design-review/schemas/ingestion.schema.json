{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://aicc.local/ldip/ingestion.schema.json",
 "title": "LDIP common ingestion file (*.dwg.json, *.pdf.json, *.xml.json) \u2014 SPC-0006 Rev B \u00a72.4, \u00a74.1.4; Rev C \u00a72.4.2, \u00a74.12",
 "description": "template_version 1.0 for DWG (skill 1) and PDF (skill 2); 1.1 for LandXML (skill 3 parsing-landxml, SPC-0006 Rev C \u00a72.4.2 I1\u2013I6, additive). DWG content per \u00a74.1.4; PDF content per \u00a74.2.4; PDF title block per K5-1 (11 Oct 2026, optional fields added); LandXML content per Rev C \u00a74.12.5.",
 "type": "object",
 "required": [
  "template_version",
  "source",
  "extractor",
  "crs",
  "title_block",
  "content",
  "warnings",
  "meta"
 ],
 "additionalProperties": false,
 "properties": {
  "template_version": {
   "enum": [
    "1.0",
    "1.1"
   ]
  },
  "source": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "minLength": 1,
     "maxLength": 250
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
     "type": "integer",
     "minimum": 0
    },
    "document_no": {
     "type": [
      "string",
      "null"
     ]
    },
    "revision": {
     "type": [
      "string",
      "null"
     ]
    },
    "file_type": {
     "enum": [
      "dwg",
      "pdf",
      "landxml"
     ]
    },
    "provenance": {
     "enum": [
      "parsons",
      "employer",
      "aicc_export"
     ],
     "description": "Rev C I3 / brief Rev G \u00a71.5: set by the caller, never guessed from content. Required for landxml."
    }
   },
   "required": [
    "path",
    "sha256",
    "bytes",
    "document_no",
    "revision",
    "file_type"
   ],
   "additionalProperties": false
  },
  "extractor": {
   "type": "object",
   "properties": {
    "skill": {
     "enum": [
      "extracting-dwg-data",
      "extracting-pdf-drawings",
      "parsing-landxml"
     ]
    },
    "script": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "converter": {
     "type": "object",
     "properties": {
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "version": {
       "type": [
        "string",
        "null"
       ]
      }
     },
