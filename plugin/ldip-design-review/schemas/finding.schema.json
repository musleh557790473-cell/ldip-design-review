{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicc.local/ldip-design-review/finding.schema.json",
  "title": "LDIP Design Review Finding",
  "description": "AICC-BIM-SPC-0003 Rev E (Rev D approved; Rev E adds ROD / EWK / COR rule IDs and reference.parameter). One finding. Candidate, verified and classified files contain arrays of findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "finding_id", "stage", "run_id", "site", "sub_id", "agent",
    "title", "statement", "issue_type", "location", "severity", "confidence",
    "evidence", "reference", "owner", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "finding_id": {
      "type": "string",
      "pattern": "^(QRWN|NMAR|NRJS)-[A-Za-z0-9._-]+-[0-9]{8}T[0-9]{4}/(INT|GIS|RDE|WET|DRY|COO|VER|CON|OUT|STR)-[0-9]{3}$"
    },
    "stage": { "enum": ["candidate", "verified", "classified", "registered"] },
    "run_id": { "type": "string", "pattern": "^(QRWN|NMAR|NRJS)-[A-Za-z0-9._-]+-[0-9]{8}T[0-9]{4}$" },
    "site": { "enum": ["QRWN", "NMAR", "NRJS"] },
    "sub_id": { "type": "string", "minLength": 1 },
    "agent": { "enum": ["INT", "GIS", "RDE", "WET", "DRY", "COO", "STR"] },
    "agent_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Skill name -> version used to produce this finding."
    },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1500,
      "description": "Factual claim only: what is observed and what the reference requires. No reasoning chain (SPC-0002 C5)."
    },
    "issue_type": {
      "enum": ["design_error", "inconsistency", "missing_information", "er_ambiguity", "package_control", "schedule_blocking"]
    },
    "location": { "$ref": "#/$defs/location" },
    "severity": { "enum": ["Critical", "Major", "Minor", "Observation"] },
    "confidence": { "enum": ["High", "Medium", "Low"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "reference": { "$ref": "#/$defs/reference" },
    "proposed_status": {
      "enum": ["Confirmed", "Probable", "Not auto-verifiable", "Missing information"],
      "description": "Finder's default status per brief §5.5. Advisory only; the Verifier sets verification.status."
    },
    "verification": { "$ref": "#/$defs/verification" },
    "commercial": { "$ref": "#/$defs/commercial" },
    "addressee": { "enum": ["Parsons", "RCRC", "Internal", "NOT_ASSESSED"] },
    "output_route": { "enum": ["CRS", "RFI", "RISK_EOT_REGISTER", "ENGINEER_QUEUE", "MANUAL_CHECK", "NONE"] },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "enum": ["SBM", "Lead GIS", "DMR", "IM", "CM", "CCM", "PM", "Document Controller"] },
        "name": { "type": ["string", "null"] }
      }
    },
    "gate": { "$ref": "#/$defs/gate" },
    "register_no": { "type": ["string", "null"], "pattern": "^LDIP-(QRWN|NMAR|NRJS)-DRF-[0-9]{4}$" },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_comment_ref": { "type": ["string", "null"], "description": "Earlier CRS comment this finding re-opens or checks (skill 7)." },
        "duplicate_of": { "type": ["string", "null"] },
        "related": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },

  "allOf": [
    {
      "$comment": "Stage gating: verification from 'verified'; commercial/addressee/route from 'classified'; gate + register_no from 'registered'.",
      "if": { "properties": { "stage": { "enum": ["verified", "classified", "registered"] } } },
      "then": { "required": ["verification"] },
      "else": { "not": { "required": ["verification"] } }
    },
    {
      "if": { "properties": { "stage": { "enum": ["classified", "registered"] } } },
      "then": { "required": ["commercial", "addressee", "output_route"] }
    },
    {
      "if": { "properties": { "stage": { "const": "registered" } } },
      "then": { "required": ["gate", "register_no"] }
    },
    {
      "$comment": "Brief §5.1/5.2: Confirmed needs a referenced rule and non-visual evidence.",
      "if": {
        "required": ["verification"],
        "properties": { "verification": { "properties": { "status": { "const": "Confirmed" } } } }
      },
      "then": {
        "properties": {
          "confidence": { "enum": ["High", "Medium"] },
          "reference": { "required": ["rule_id"], "properties": { "rule_id": { "type": "string" } } },
          "verification": { "properties": { "recheck_result": { "const": "agrees" } } }
        }
      }
    },
    {
      "$comment": "Brief §4.3c: disagreement never retries; it is Probable.",
      "if": {
        "required": ["verification"],
        "properties": { "verification": { "properties": { "recheck_result": { "const": "disagrees" } } } }
      },
      "then": { "properties": { "verification": { "properties": { "status": { "const": "Probable" } } } } }
    },
    {
      "$comment": "Brief §5.1: Not auto-verifiable must say what to check and where.",
      "if": {
        "required": ["verification"],
        "properties": { "verification": { "properties": { "status": { "const": "Not auto-verifiable" } } } }
      },
      "then": { "properties": { "verification": { "required": ["manual_check"] } } }
    },
    {
      "$comment": "Missing information is always issue_type missing_information and cites the obligation.",
      "if": {
        "required": ["verification"],
        "properties": { "verification": { "properties": { "status": { "const": "Missing information" } } } }
      },
      "then": {
        "properties": {
          "issue_type": { "const": "missing_information" },
          "reference": { "required": ["source_doc", "clause"] }
        }
      }
    },
    {
      "$comment": "Brief §5.4: Low confidence (visual/colour only) can never be Confirmed.",
      "if": { "properties": { "confidence": { "const": "Low" } } },
      "then": {
        "not": {
          "required": ["verification"],
          "properties": { "verification": { "properties": { "status": { "const": "Confirmed" } } } }
        }
      }
    }
  ],

  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_no"],
      "anyOf": [
        { "required": ["dwg"] },
        { "required": ["pdf"] },
        { "required": ["table"] },
        { "required": ["xy"] },
        { "required": ["plot_ids"] },
        { "required": ["package_level"] }
      ],
      "properties": {
        "document_no": { "type": "string", "description": "Parsons document number, e.g. LDIP-RCRC-SAP-01-QRWN-MPL-SCH-00001" },
        "revision": { "type": ["string", "null"] },
        "file_path": { "type": "string", "description": "Relative to LDIP_Review/" },
        "file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sheet_no": { "type": ["string", "null"] },
        "dwg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "handles": { "type": "array", "items": { "type": "string" } },
            "layer": { "type": "string" },
            "layout": { "type": "string" }
          }
        },
        "pdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "bbox_pt": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sheet", "cells"],
          "properties": {
            "sheet": { "type": "string" },
            "cells": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]+(:[A-Z]{1,3}[0-9]+)?$" }, "minItems": 1 }
          }
        },
        "xy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crs", "e", "n"],
          "properties": {
            "crs": { "const": "EPSG:32638" },
            "e": { "type": "number" },
            "n": { "type": "number" }
          }
        },
        "plot_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "chainage": { "type": ["string", "null"] },
        "package_level": { "type": "boolean", "description": "True when the finding concerns the whole submittal (e.g. a missing drawing)." }
      }
    },

    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "tier", "source_type", "extract"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
        "tier": { "enum": ["deterministic", "extracted_text_crop", "visual"] },
        "source_type": {
          "enum": ["dwg_vector", "pdf_vector_text", "pdf_ocr", "pdf_raster_visual", "pdf_colour", "xlsx_cell", "csv_cell", "landxml", "script_output"]
        },
        "extract": { "type": "string", "description": "Verbatim value or text as read from the source." },
        "measured_value": { "type": ["number", "string", "null"] },
        "unit": { "type": ["string", "null"] },
        "artifact_path": { "type": ["string", "null"], "description": "Crop / extract file under findings/<run>/evidence/<agent>/" },
        "artifact_sha256": { "type": ["string", "null"] },
        "script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "exit_code"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "exit_code": { "type": "integer" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "tier": { "const": "deterministic" } } },
          "then": { "properties": { "source_type": { "enum": ["dwg_vector", "xlsx_cell", "csv_cell", "landxml", "script_output"] } } } },
        { "if": { "properties": { "tier": { "const": "extracted_text_crop" } } },
          "then": { "properties": { "source_type": { "enum": ["pdf_vector_text", "pdf_ocr"] } }, "required": ["artifact_path"] } },
        { "if": { "properties": { "source_type": { "enum": ["pdf_raster_visual", "pdf_colour"] } } },
          "then": { "properties": { "tier": { "const": "visual" } } } }
      ]
    },

    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": ["string", "null"], "pattern": "^(PKG|GIS|ROD|EWK|COR|RDE|WET|DRY|COO|STR)-[0-9]{3}$" },
        "parameter": { "type": ["string", "null"], "description": "Rule parameter whose sub-check raised the finding (SPC-0003 Rev E §4.8); an advisory parameter caps the status at Probable (SPC-0004 Rev E §4.7)." },
        "rulebook_version": { "type": ["string", "null"] },
        "source_doc": { "type": ["string", "null"], "description": "Code, ER, BEP, MIDP or contract document title/number" },
        "clause": { "type": ["string", "null"] },
        "required_value": { "type": ["number", "string", "null"] },
        "tolerance": { "type": ["number", "string", "null"] },
        "unit": { "type": ["string", "null"] }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recheck_result", "method", "verified_at"],
      "properties": {
        "status": { "enum": ["Confirmed", "Probable", "Not auto-verifiable", "Missing information"] },
        "recheck_result": { "enum": ["agrees", "disagrees", "not_rechecked"] },
        "method": { "type": "string", "minLength": 5, "description": "How the Verifier independently re-checked (script, re-extraction, crop)." },
        "manual_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["what", "where"],
          "properties": { "what": { "type": "string" }, "where": { "type": "string" } }
        },
        "verifier_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "notes": { "type": ["string", "null"] },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },

    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact"],
      "properties": {
        "impact": { "enum": ["None", "Parsons_liability", "VO_candidate", "EOT_candidate", "NOT_ASSESSED"] },
        "schedule_impact": { "enum": ["None", "Non-critical", "Critical_path", "NOT_ASSESSED"] },
        "notes": { "type": ["string", "null"] }
      }
    },

    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["PENDING", "APPROVED", "MODIFIED", "REJECTED", "DEFERRED"] },
        "decided_by": { "type": ["string", "null"] },
        "decided_at": { "type": ["string", "null"], "format": "date-time" },
        "comment": { "type": ["string", "null"] }
      },
      "if": { "properties": { "status": { "enum": ["APPROVED", "MODIFIED", "REJECTED", "DEFERRED"] } } },
      "then": { "required": ["decided_by", "decided_at"], "properties": { "decided_by": { "type": "string" }, "decided_at": { "type": "string" } } }
    }
  }
}
