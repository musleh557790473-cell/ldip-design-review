{
  "tag": "[AGREED 21:55]",
  "note": "Wet-network plan layers for STO / SWN / PWT / IRR-10000 drawings (skill 11, DQ-6). Match on short name after the last '$'. Diameter from layer via Pipe Dia (\\d+) or %%c(\\d+)mm. Per-site entries added when QRWN / NRJS plans differ.",
  "default_site": "NMAR",
  "shared_layers": {
