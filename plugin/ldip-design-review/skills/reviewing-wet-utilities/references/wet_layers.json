    "C-SSWR-MNHL-P": {"utility": "sewer", "feature": "manhole"},
    "Xref-Storm CB": {"utility": "storm", "feature": "catch_basin"},
    "HP": {"utility": "storm", "feature": "catch_basin"},
    "LP": {"utility": "storm", "feature": "catch_basin"},
    "outlet Stru": {"utility": "storm", "feature": "outfall"},
    "Catchments": {"utility": "storm", "feature": "catchment"},
    "C-PW-BUTTERFLY VALVE": {"utility": "water", "feature": "valve"},
    "C-PW-VALVE": {"utility": "water", "feature": "valve"},
