  "layer_patterns": [
    {
      "regex": "(?i)SS_Pipe Dia (\\d+)",
      "utility": "sewer",
      "feature": "pipe",
      "diameter_group": 1,
      "note": "CI-Ss_50_35_08_30-P-SS_Pipe Dia <D>"
