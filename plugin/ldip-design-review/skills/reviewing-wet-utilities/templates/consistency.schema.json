{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ldip-design-review/reviewing-wet-utilities/consistency.schema.json",
  "title": "LDIP wet consistency (skill 11) — SPC-0006 Rev Q §4.19; report only (DQ-11)",
  "type": "object",
  "additionalProperties": false,
  "required": ["consistency_version", "comparisons", "findings", "counts", "meta"],
  "properties": {
    "consistency_version": {"const": "1.0"},
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "result"],
        "properties": {
          "check": {"enum": ["W1", "W2", "W3", "W5", "W6", "W8"]},
          "result": {
            "enum": ["pass", "flag", "observation", "information", "not_run"]
          },
          "severity": {
            "type": ["string", "null"],
            "enum": ["Critical", "Major", "Minor", "Observation", null]
          },
          "proposed_status": {
            "type": ["string", "null"],
            "enum": ["Confirmed", "Probable", "Not auto-verifiable", "Missing information", null]
          }
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "description": "SPC-0003-shaped candidates; report only — reference.rule_id must be null (DQ-11).",
      "items": {
        "type": "object",
        "required": ["issue_type", "reference", "report_only", "agent"],
        "properties": {
          "issue_type": {
            "enum": ["inconsistency", "missing_information", "design_error", "er_ambiguity", "package_control", "schedule_blocking"]
          },
          "reference": {
            "type": "object",
            "properties": {
              "rule_id": {"type": "null", "description": "DQ-11: WUT states change in next rulebook"}
            }
          },
          "report_only": {"const": true},
          "agent": {"const": "WUT"},
          "severity": {
            "enum": ["Critical", "Major", "Minor", "Observation"]
          },
          "proposed_status": {
            "enum": ["Confirmed", "Probable", "Not auto-verifiable", "Missing information"]
          },
          "owner": {
            "type": "object",
            "properties": {
              "role": {"const": "DMR"}
            }
          }
        },
        "additionalProperties": true
      }
    },
    "counts": {
      "type": "object",
      "required": ["comparisons", "findings"],
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "required": ["marking"],
      "additionalProperties": true
    }
  }
}
